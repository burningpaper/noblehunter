# Copy the parts you need to .env or .env.local. Never commit the real files.
# Values below are names only; see README.md for where each one comes from.

# --- Pipeline (Mac Mini) ---------------------------------------------------------------
SERPER_API_KEY=
BRAVE_API_KEY=
# Least-privilege role written by `python -m pipeline.cli db create-roles` (to .env.roles.local).
PIPELINE_DATABASE_URL=

# --- Neon owner connection (migrations and admin commands) ------------------------------
# Pooled URL for general use; direct (unpooled) URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Web app (Vercel environment variables) ---------------------------------------------
# Pooled URL for the noble_web role, from .env.roles.local.
WEB_DATABASE_URL=
# At least 32 random characters; changing it signs everyone out.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=
# Set to false only for local http development.
SECURE_COOKIES=true
