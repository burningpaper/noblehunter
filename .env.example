# Copy the parts you need to .env or .env.local. Never commit the real files.
# Values below are names only; see README.md for where each one comes from.

# --- Pipeline (Mac Mini) ---------------------------------------------------------------
SERPER_API_KEY=
BRAVE_API_KEY=
# Least-privilege role written by `python -m pipeline.cli db create-roles` (to .env.roles.local).
PIPELINE_DATABASE_URL=

# --- Neon owner connection (migrations and admin commands) ------------------------------
# Pooled URL for general use; direct (unpooled) URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Web app (Vercel environment variables) ---------------------------------------------
# Pooled URL for the noble_web role, from .env.roles.local.
WEB_DATABASE_URL=
# At least 32 random characters; changing it signs everyone out.
SESSION_SECRET=
# Sign-in, and the Gmail connection. The Mac Mini needs these too, to refresh mail tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=
# Set to false only for local http development.
SECURE_COOKIES=true

# --- Claude (both the Mac Mini and Vercel) ----------------------------------------------
# Contact research on the Mac Mini, and Ask Claude suggestions in the web app.
# Without it the web app still runs; Ask Claude says the key is missing.
ANTHROPIC_API_KEY=

# --- Email pitching (both the Mac Mini and Vercel) --------------------------------------
# Fernet key that encrypts stored Gmail refresh tokens. The SAME value in both places.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, mail is simply switched off; changing it means reconnecting every mailbox.
MAIL_TOKEN_KEY=
